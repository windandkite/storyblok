<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
?>
<script>
    // Registered straight away once Alpine is running: a blok added in the Visual Editor brings this script after
    // alpine:init has fired.
    (register => window.Alpine ? register() : window.addEventListener('alpine:init', register, { once: true }))(() => {
        Alpine.data('initStoryblokCarousel', () => ({
            active: 0,
            atEnd: false,

            init() {
                this.onScroll();
            },
            // Works for one or many slides per view: the active slide is the first one at the start edge.
            onScroll() {
                const track = this.$refs.track;
                const slideWidth = track.children[0] ? track.children[0].offsetWidth : track.clientWidth;

                this.active = Math.round(Math.abs(track.scrollLeft) / Math.max(slideWidth, 1));
                this.atEnd = Math.abs(track.scrollLeft) + track.clientWidth >= track.scrollWidth - 1;
            },
            scrollToIndex(index) {
                const track = this.$refs.track;
                const slide = track.children[Math.max(0, Math.min(index, track.children.length - 1))];

                if (!slide) {
                    return;
                }

                // Brings the slide's start edge to the track's: the left edge, or the right one in RTL, where
                // scrollLeft runs from 0 to negative. Smoothness comes from CSS.
                const slideRect = slide.getBoundingClientRect();
                const trackRect = track.getBoundingClientRect();
                const offset = getComputedStyle(track).direction === 'rtl'
                    ? slideRect.right - (trackRect.right - track.clientLeft)
                    : slideRect.left - (trackRect.left + track.clientLeft);

                track.scrollTo({ left: track.scrollLeft + offset });
            },
            prev() {
                this.scrollToIndex(this.active - 1);
            },
            next() {
                this.scrollToIndex(this.active + 1);
            },
            goTo() {
                this.scrollToIndex(Number(this.$el.dataset.index));
            },
            isAtStart() {
                return this.active === 0;
            },
            isAtEnd() {
                return this.atEnd;
            },
            // False when every slide already fits in view, e.g. 4 products at 4 per row.
            isScrollable() {
                return !(this.active === 0 && this.atEnd);
            },
            isDotActive() {
                return Number(this.$el.dataset.index) === this.active ? 'true' : false;
            },
        }));
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
