<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
?>
<script>
    // Registered straight away once Alpine is running: a blok added in the Visual Editor brings this script after
    // alpine:init has fired.
    (register => window.Alpine ? register() : window.addEventListener('alpine:init', register, { once: true }))(() => {
        Alpine.data('initStoryblokButton', () => ({
            dispatch() {
                window.dispatchEvent(new CustomEvent(this.$el.dataset.event, {
                    detail: { target: this.$el.dataset.target || null, trigger: this.$el },
                }));
            },
        }));
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
