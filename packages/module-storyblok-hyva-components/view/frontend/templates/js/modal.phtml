<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
?>
<script>
    // Registered straight away once Alpine is running: a blok added in the Visual Editor brings this script after
    // alpine:init has fired.
    (register => window.Alpine ? register() : window.addEventListener('alpine:init', register, { once: true }))(() => {
        Alpine.data('initStoryblokModal', () => ({
            // Opened / closed from "button" bloks: storyblok-open / storyblok-close with detail.target = dialog id.
            init() {
                const dialog = this.$refs.dialog;

                this.onOpenEvent = (event) => {
                    if (event.detail && event.detail.target === dialog.id && !dialog.open) {
                        this.open();
                    }
                };
                this.onCloseEvent = (event) => {
                    if (event.detail && event.detail.target === dialog.id) {
                        this.close();
                    }
                };
                window.addEventListener('storyblok-open', this.onOpenEvent);
                window.addEventListener('storyblok-close', this.onCloseEvent);
            },
            // The Visual Editor replaces bloks on every edit: listeners on window would outlive them.
            destroy() {
                window.removeEventListener('storyblok-open', this.onOpenEvent);
                window.removeEventListener('storyblok-close', this.onCloseEvent);
            },
            open() {
                this.$refs.dialog.showModal();
                document.documentElement.classList.add('overflow-hidden');
            },
            close() {
                this.$refs.dialog.close();
            },
            // Fires for the close button, ESC and backdrop clicks alike.
            onClose() {
                if (!document.querySelector('dialog[open]')) {
                    document.documentElement.classList.remove('overflow-hidden');
                }
            },
            // The dialog itself only receives the click when the backdrop was clicked.
            onDialogClick(event) {
                if (event.target === this.$refs.dialog) {
                    this.close();
                }
            },
        }));
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
