<?php
/**
 * @storyblok {
 *   "folder": "Content",
 *   "description": "Unopinionated heading block supporting dynamic tag overrides and tokenized styling.",
 *   "whitelists": ["content"],
 *   "fields": {
 *     "title": {"type": "string", "required": true},
 *     "tag": {"type": "string", "enum": ["h1", "h2", "h3", "h4", "h5", "h6", "p", "div", "span"], "default": "h2", "tab": "Settings"},
 *     "visual_size": {"type": "string", "enum": ["small", "medium", "large", "display"], "default": "medium", "tab": "Settings"},
 *     "accent_line": {"type": "boolean", "default": false, "description": "Left visual accent line", "tab": "Settings"}
 *   }
 * }
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use WindAndKite\Storyblok\Block\Block;

/** @var Block|\WindAndKite\Storyblok\Ide\Block\TitleSectionBlok $block */
/** @var Escaper $escaper */

$title = trim((string)$block->getData('title'));

if ($title === '') {
    return;
}

$tag = in_array($block->getData('tag'), ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div', 'span'], true)
    ? $block->getData('tag')
    : 'h2';

$size = [
    'small' => 'text-lg md:text-xl font-semibold',
    'medium' => 'text-2xl md:text-3xl font-semibold',
    'large' => 'text-3xl md:text-4xl font-bold',
    'display' => 'text-4xl md:text-6xl font-bold tracking-tight',
][(string)$block->getData('visual_size')] ?? 'text-2xl md:text-3xl font-semibold';

$accent = $block->getData('accent_line') ? 'border-s-4 border-current ps-4' : '';
?>
<<?= /** @noEscape */ $tag ?> class="<?= $escaper->escapeHtmlAttr(trim($size . ' ' . $accent)) ?>"><?= $escaper->escapeHtml($title) ?></<?= /** @noEscape */ $tag ?>>
