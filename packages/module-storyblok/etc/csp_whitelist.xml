<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-ancestors">
            <values>
                <!-- Only the Visual Editor: other subdomains, like a.storyblok.com, serve files anyone can upload. -->
                <value id="windandkite_storyblok" type="host">app.storyblok.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <!-- Only the Visual Editor: other subdomains, like a.storyblok.com, serve files anyone can upload. -->
                <value id="windandkite_storyblok" type="host">app.storyblok.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="windandkite_storyblok" type="host">*.storyblok.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="windandkite_storyblok" type="host">*.storyblok.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
