<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use WindAndKite\Storyblok\ViewModel\StoryblokBridgeConfig;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var StoryblokBridgeConfig $storyblokConfig */
$storyblokConfig = $block->getData('storyblok_bridge_config');

if (!$storyblokConfig->shouldInitializeStoryblokBridge()) {
    return;
}

$ajaxUrl = $storyblokConfig->getAjaxUrl();
$shareUrl = $storyblokConfig->getShareUrl();
?>
<?php if ($shareUrl): ?>
<button type="button"
        id="storyblok-share-link"
        data-url="<?= $escaper->escapeHtmlAttr($shareUrl) ?>"
        style="position:fixed;right:16px;bottom:16px;z-index:2147483647;padding:8px 14px;border:0;border-radius:6px;background:#09b3af;color:#fff;font:600 13px/1.4 sans-serif;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.2)">
    <?= $escaper->escapeHtml(__('Copy share link')) ?>
</button>
<script>
    (() => {
        const button = document.getElementById('storyblok-share-link');
        const label = button.textContent.trim();

        button.addEventListener('click', () => {
            const url = button.dataset.url;
            // The editor iframe may not allow clipboard access: show the link to copy instead.
            const fallback = () => window.prompt('<?= $escaper->escapeJs(__('Copy this link to share the draft:')) ?>', url);

            if (!navigator.clipboard) {
                fallback();
                return;
            }

            navigator.clipboard.writeText(url).then(() => {
                button.textContent = '<?= $escaper->escapeJs(__('Link copied')) ?>';
                setTimeout(() => button.textContent = label, 2000);
            }, fallback);
        });
    })();
</script>
<?php endif; ?>
<script type="text/javascript">
    (function() {
        let storyblokInstance = null;
        const queuedOnCalls = [];

        window.StoryblokBridge = function(options) {
            if (storyblokInstance) {
                return storyblokInstance;
            }
            const proxy = {
                on: function() {
                    queuedOnCalls.push(arguments);
                }
            };
            return proxy;
        };

        const updateBlocksViaAjax = (story, signal) => {
            fetch('<?= $escaper->escapeJs($ajaxUrl) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ story, _storyblok: story.id }),
                signal: signal
            })
                .then(response => {
                    if (!response.ok) {
                        console.error('Storyblok Bridge: AJAX update failed.', response.statusText);
                        throw new Error('AJAX update failed');
                    }

                    return response.json();
                })
                .then(data => {
                    if (!data || typeof data !== 'object') return;

                    for (const blokUid in data) {
                        if (data.hasOwnProperty(blokUid)) {
                            const newHtml = data[blokUid];
                            const selector = `[data-blok-uid="${story.id}-${blokUid}"]`;
                            const elementToUpdate = document.querySelector(selector);

                            if (elementToUpdate) {
                                const template = document.createElement('template');
                                template.innerHTML = newHtml;
                                const nodes = [...template.content.childNodes];
                                elementToUpdate.replaceWith(...nodes);

                                // Scripts inserted as HTML don't run: re-create them so the blok's Alpine code loads.
                                nodes.flatMap(node => node.nodeType !== Node.ELEMENT_NODE ? []
                                    : node.matches('script') ? [node] : [...node.querySelectorAll('script')]
                                ).forEach(oldScript => {
                                    const script = document.createElement('script');
                                    [...oldScript.attributes].forEach(({ name, value }) => script.setAttribute(name, value));
                                    script.textContent = oldScript.textContent;
                                    oldScript.replaceWith(script);
                                });
                            } else {
                                console.warn(`Storyblok Bridge: Element with selector ${selector} not found for update.`);
                            }
                        }
                    }
                })
                .catch(error => {
                    if (error.name !== 'AbortError' && error.message !== 'AJAX update failed') {
                        console.error('Storyblok Bridge: Error during update process.', error);
                    }
                });
        };

        const initActualStoryblokBridge = () => {
            if (storyblokInstance) {
                return;
            }

            const { StoryblokBridge: ActualStoryblokBridge } = window;

            storyblokInstance = new ActualStoryblokBridge({
                preventClicks: true
            });

            queuedOnCalls.forEach(args => {
                storyblokInstance.on.apply(storyblokInstance, args);
            });

            storyblokInstance.on(
                ['published', 'change'],
                () => window.location.reload()
            );

            let controller = { abort: () => {} };
            let lastBlockIds = {};

            storyblokInstance.on(['input'], ({ story }) => {
                controller.abort();

                controller = new AbortController();
                const { signal } = controller;

                // Content types without a body field have no top-level bloks to add or remove.
                let currentBlokIds = (story.content.body || []).map(el => el['_uid']);

                const previousBlokIds = lastBlockIds[story.id] || [];

                if (currentBlokIds.length < previousBlokIds.length) {
                    let removedBlokIds = previousBlokIds.filter(id => !currentBlokIds.includes(id));

                    removedBlokIds.forEach(id => {
                        const removedElement = document.querySelector(`[data-blok-uid="${story.id}-${id}"]`);
                        if (removedElement) {
                            removedElement.remove();
                        } else {
                            console.warn(`Storyblok Bridge: Element with data-blok-uid="${story.id}-${id}" not found for removal.`);
                        }
                    });

                    lastBlockIds[story.id] = currentBlokIds;

                    return;
                }

                lastBlockIds[story.id] = currentBlokIds;
                updateBlocksViaAjax(story, signal);
            });
        };

        const loadStoryblokScript = () => {
            if (document.getElementById('storyblok-bridge-script')) {
                return;
            }

            const script = document.createElement('script');
            script.async = true;
            script.src = "//app.storyblok.com/f/storyblok-v2-latest.js";
            script.id = "storyblok-bridge-script";
            script.onload = initActualStoryblokBridge;
            document.head.appendChild(script);
        };

        document.addEventListener('scroll', loadStoryblokScript, { once: true });
        document.addEventListener('mousemove', loadStoryblokScript, { once: true });
        document.addEventListener('keydown', loadStoryblokScript, { once: true });
        document.addEventListener('touchstart', loadStoryblokScript, { once: true });

        <?php if ($storyblokConfig->shouldInitializeStoryblokBridge()): ?>
        setTimeout(loadStoryblokScript, 0);
        <?php endif; ?>

    })();
</script>
